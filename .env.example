# Leave all empty to run in demo mode. On Vercel the Supabase integration sets equivalent names
# (SUPABASE_URL, POSTGRES_URL, …) automatically; see docs/DEPLOY.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy JWT secret (set by the Vercel integration); sessions are then checked without a request to Supabase
SUPABASE_JWT_SECRET=
# Supabase pooler connection string (Transaction mode, port 6543)
DATABASE_URL=
# Direct connection (port 5432), used only by `npm run db:migrate`
DIRECT_URL=
# Secret used by Vercel Cron to call /api/cron/*
CRON_SECRET=
# TURN relay so people on different internet connections can connect (see docs/DEPLOY.md).
# Cloudflare Realtime TURN (free up to 1000 GB/month): short-lived credentials are generated on the server.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Or any provider with fixed credentials (comma separated urls). Private: handed only to signed-in browsers.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Admin account created automatically on first use (set these in Vercel)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
# Optional: require this code on the first-run /setup page (used only if ADMIN_* is not set)
ADMIN_SETUP_CODE=
