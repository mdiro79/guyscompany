# Leave all empty to run in demo mode (in-memory data, demo users, no Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase pooler connection string (Transaction mode, port 6543)
DATABASE_URL=
# Secret used by Vercel Cron to call /api/cron/*
CRON_SECRET=
# Optional TURN server (free tier), comma separated urls
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
